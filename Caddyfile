{
	admin off
	# ACME email for Let's Encrypt notifications (production only)
	email {$ACME_EMAIL:}
}

# CADDY_HOST controls where Caddy listens:
#   local dev  → CADDY_HOST=:80   (HTTP, no TLS)
#   production → CADDY_HOST=yourdomain.com  (auto HTTPS via Let's Encrypt)
{$CADDY_HOST::80} {
	handle /api/* {
		reverse_proxy be:8080
	}

	handle /webhooks/* {
		reverse_proxy be:8080
	}

	handle /health {
		reverse_proxy be:8080
	}

	handle {
		reverse_proxy fe:3000
	}
}
